# Copy to .env.local and adjust per environment.

VITE_APP_ENV=Development
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME=Admin Boilerplate

# --- Tunable settings --------------------------------------------------
# How long (ms) the "Undo" action stays available after a delete before it's committed for real.
VITE_UNDO_WINDOW_MS=5000

# --- Feature flags (true | false) -----------------------------------
VITE_FEATURE_USER_REGISTRATION=true
VITE_FEATURE_MS_SSO_ONLY=false
VITE_FEATURE_BACKEND_NAV=false
VITE_FEATURE_BACKEND_RBAC=false
VITE_FEATURE_USE_MOCK_DATA=true
VITE_FEATURE_MAINTENANCE_MODE=false

# --- Microsoft SSO / Graph (required if VITE_FEATURE_MS_SSO_ONLY=true or Mail/Files modules are enabled) ---
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
VITE_MSAL_REDIRECT_URI=http://localhost:5173

# --- Tolgee (translation platform) -----------------------------------
VITE_TOLGEE_API_URL=
VITE_TOLGEE_API_KEY=
